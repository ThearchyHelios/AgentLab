# 复制成 .env 后按需修改。所有项都可以留空——留空时用代码里的默认值。
# API Key 也可以不写在这里，启动后在「设置 → 模型接入」页面填，会加密存进本地 SQLite。

# ---- 环境 ----
# 后端跑在哪个 conda 环境里（dev.sh 用）
# AGENTLAB_CONDA_ENV=agentlab

# ---- 服务 ----
# AGENTLAB_PORT=8000
# AGENTLAB_WEB_PORT=5273

# ---- 沙箱 ----
# auto（挑第一个已就绪的：microvm → bubblewrap → seatbelt → local）
# 可选值：microvm | seatbelt | bubblewrap | local | off
# AGENTLAB_SANDBOX_BACKEND=auto

# ---- microVM 沙箱（独立 Linux 内核，需 conda 环境装了 [microvm] 额外依赖）----
# 注意：内存/CPU/进程表是内核级真限额，但网络关不干净——HTTP/HTTPS 断得掉，
# UDP/53 拦不住，DNS 隧道外泄通道始终开着。防外泄要靠网络层，别指望沙箱。
# 跑代码用的 OCI 镜像，首次使用会拉取并缓存到 ~/.microsandbox（实测约 55s，仅此一次）
# AGENTLAB_MICROVM_IMAGE=python:3.12-slim
# 同 session 复用同一台 VM；空闲这么久就回收，避免闲置 VM 占内存
# AGENTLAB_MICROVM_IDLE_SECONDS=300
# 单次启动（含首次拉镜像）的等待上限
# AGENTLAB_MICROVM_BOOT_TIMEOUT=300
# AGENTLAB_SANDBOX_TIMEOUT=30
# 内存限额：microvm 后端真实生效；seatbelt/local 在 macOS 上限不住（不强制 RLIMIT_AS）
# AGENTLAB_SANDBOX_MEMORY_MB=512
# AGENTLAB_SANDBOX_NETWORK=false

# ---- 执行护栏 ----
# AGENTLAB_MAX_GRAPH_STEPS=200
# AGENTLAB_MAX_AGENT_STEPS=25
# AGENTLAB_MAX_CONCURRENT_RUNS=20

# ---- HTTP 工具 ----
# 逗号分隔的域名白名单；留空表示只拦内网地址，不限制公网域名
# AGENTLAB_HTTP_TOOL_ALLOWLIST=api.github.com,news.ycombinator.com

# ---- 落库加密密钥 ----
# 留空会自动生成并存到 data/.secret_key。换了这个值，之前存的 API Key 会解不开。
# AGENTLAB_SECRET_KEY=

# ---- 模型凭据（可选，首次启动会自动导入成 provider）----
# ANTHROPIC_API_KEY=sk-ant-...
# 用中转网关时填这两个（会以 Authorization: Bearer 发送）
# ANTHROPIC_BASE_URL=https://your-gateway.example.com/api
# ANTHROPIC_AUTH_TOKEN=...
# OPENAI_API_KEY=sk-...

# ---- 可选增强 ----
# 配了就用 Tavily 搜索，否则 web_search 退回 DuckDuckGo
# TAVILY_API_KEY=tvly-...
# 打开后知识库用 OpenAI embedding 代替本地哈希向量（检索质量更好）
# AGENTLAB_USE_OPENAI_EMBEDDINGS=1
